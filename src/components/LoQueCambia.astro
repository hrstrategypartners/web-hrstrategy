---
const filas = [
  {
    antes: 'Sabés que algo falla, pero no cuánto cuesta.',
    despues: 'Medimos riesgos y costos para que sepas qué resolver primero.',
    etapa: 'Medimos'
  },
  {
    antes: 'Todo necesita una decisión tuya.',
    despues: 'Definimos responsabilidades para que puedas delegar y recuperar tiempo.',
    etapa: 'Ordenamos'
  },
  {
    antes: 'Los datos están dispersos en planillas.',
    despues: 'Reunimos los indicadores en un tablero para que decidas con información clara.',
    etapa: 'Centralizamos'
  },
  {
    antes: 'No podés mostrar qué recuperaste de la inversión.',
    despues: 'Comparamos el punto de partida con los resultados y documentamos el impacto económico.',
    etapa: 'Demostramos'
  },
  {
    antes: 'Se van personas clave y volvés a empezar.',
    despues: 'Implementamos un plan de retención y medimos cómo cambia la rotación.',
    etapa: 'Retenemos'
  }
];
const diaADia = [
  { icono: '/images/menos-urgencias.webp', tamano: 'w-[38px] h-[38px] sm:w-[50px] sm:h-[50px]', titulo: 'Menos urgencias', texto: 'Más tiempo para dirigir, sin correr detrás de cada problema.' },
  { icono: '/images/mas-claridad.webp', tamano: 'w-12 h-12 sm:w-16 sm:h-16', titulo: 'Más claridad', texto: 'Para decidir y que tu equipo sepa cómo avanzar.' }
];
---
<section id="cambia" class="bg-white px-4 sm:px-8 lg:px-16 pt-[clamp(24px,3vw,40px)] pb-[clamp(40px,4.4vw,64px)]">
  <div class="max-w-[1200px] mx-auto">
    <p class="mb-3.5 text-[12px] font-bold tracking-[3px] uppercase text-brand-blue underline underline-offset-4 decoration-2">Resultados</p>
    <h2 class="m-0 max-w-[24ch] text-[clamp(26px,2.9vw,38px)] font-extrabold tracking-[-.5px] leading-[1.04] text-ink">
      Lo que cambia cuando trabajamos juntos
    </h2>
    <p class="mt-3.5 max-w-[56ch] text-[15.5px] leading-[1.7] text-[#4A5568]">Del costo que identificamos a los cambios que implementamos con tu equipo.</p>

    <ol data-cartas-cambia class="relative m-0 mt-[clamp(28px,3.2vw,44px)] grid list-none gap-5 p-0 max-xl:max-w-[760px] xl:grid-cols-5">
      {filas.map((f, i) => (
        <li data-reveal style={`transition-delay:${i * 90}ms`} class="group relative grid grid-cols-[40px_1fr] gap-x-4 xl:flex xl:flex-col xl:gap-0">
          {i < filas.length - 1 && (
            <span aria-hidden="true" class="absolute left-[19px] top-[20px] h-[calc(100%+20px)] w-[2px] bg-brand-violet/20 xl:left-1/2 xl:top-[25px] xl:h-[2px] xl:w-[calc(100%+20px)]"><span class="absolute inset-0 origin-top scale-y-0 bg-brand-violet transition-transform duration-[900ms] ease-out group-[.is-enlazado]:scale-y-100 xl:origin-left xl:scale-x-0 xl:scale-y-100 xl:group-[.is-enlazado]:scale-x-100 motion-reduce:transition-none"></span></span>
          )}
          <div class="relative z-10 row-start-1 xl:flex xl:h-[52px] xl:items-center xl:justify-center">
            <span aria-hidden="true" class="grid h-10 w-10 place-items-center rounded-full border-2 border-brand-violet/35 bg-white text-[14px] font-extrabold text-brand-violet transition-[scale,background-color,border-color,box-shadow] duration-500 ease-out group-[.is-activo]:border-brand-violet group-[.is-activo]:bg-brand-violet group-[.is-activo]:text-white group-[.is-activo]:ring-[6px] group-[.is-activo]:ring-brand-violet/15 group-[.is-actual]:scale-110 group-[.is-actual]:shadow-[0_0_26px_6px_rgba(200,107,232,.45)] motion-reduce:transition-none">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <article class="col-start-2 flex flex-1 flex-col rounded-[18px] border border-ink/[.08] bg-white p-[clamp(20px,1.8vw,26px)] shadow-card transition duration-500 ease-out xl:col-start-auto xl:mt-4 xl:text-center group-[.is-activo]:border-brand-violet/40 group-[.is-actual]:-translate-y-1 group-[.is-actual]:shadow-[0_0_0_1px_rgba(200,107,232,.45),0_0_28px_4px_rgba(200,107,232,.35),0_22px_48px_rgba(123,92,196,.32)] motion-reduce:transition-none hover:shadow-[0_0_0_1px_rgba(200,107,232,.45),0_0_28px_4px_rgba(200,107,232,.35),0_22px_48px_rgba(123,92,196,.32)]">
            <h3 class="m-0 text-[clamp(21px,1.9vw,26px)] font-extrabold leading-[1.1] tracking-[-.3px] text-brand-violet">{f.etapa}</h3>
            <p class="mt-4 mb-4 text-[14.5px] leading-[1.55] text-[#5C6B8A]"><span class="mr-1.5 text-[12px] font-bold uppercase tracking-[1.2px]">Hoy:</span><span class="decoration-ink/25 line-through decoration-1">{f.antes}</span></p>
            <p class="mt-auto mb-0 border-t border-ink/[.08] pt-4 text-[16.5px] font-semibold leading-[1.5] text-ink">{f.despues}</p>
          </article>
        </li>
      ))}
    </ol>

    <div class="mt-[clamp(24px,2.8vw,36px)]">
      <p class="m-0 text-[13px] font-bold tracking-[1.5px] uppercase text-[#5C6B8A]">Y en tu día a día</p>
      <ul class="mt-4 grid gap-2 md:grid-cols-2 md:gap-8 max-w-[1040px]">
        {diaADia.map((beneficio) => (
          <li class="flex items-center gap-4 sm:gap-5 p-4 sm:p-5 text-ink">
            <span class="grid place-items-center flex-none w-16 h-16 sm:w-[88px] sm:h-[88px] p-2 sm:p-3">
              <img src={beneficio.icono} alt="" width="192" height="192" loading="lazy" class:list={['block object-contain', beneficio.tamano]} />
            </span>
            <div class="min-w-0">
              <p class="m-0 text-[18px] font-bold leading-[1.4]">{beneficio.titulo}</p>
              <p class="mt-1.5 max-w-[34ch] text-[14.5px] leading-[1.6] text-[#4A5568]">{beneficio.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
