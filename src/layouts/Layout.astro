---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  path?: string;
  /** false para páginas que no deben aparecer en buscadores (privacidad, 404). */
  indexable?: boolean;
  /** Objetos JSON-LD (schema.org) de la página. */
  schema?: object[];
}

// Solo el deploy de producción de Netlify (CONTEXT=production) se indexa;
// las vistas previas de PR y el build local salen con noindex.
const esBorrador = process.env.CONTEXT !== 'production';
const BASE = 'https://hrstrategypartners.com.ar';

const {
  title = 'HR Strategy Partners · Arquitectura organizacional para empresas en crecimiento · NOA',
  description = 'Lo que no estructurás, lo pagás. Convertimos estructura en capacidad para crecer. Diagnóstico de 30 minutos, sin costo. Salta · NOA · Argentina.',
  ogTitle = 'Lo que no estructurás, lo pagás. · HR Strategy Partners',
  path = '/',
  indexable = true,
  schema = []
} = Astro.props;
const ruta = path.endsWith('/') ? path : `${path}/`;
const url = `${BASE}${ruta}`;
const robots = esBorrador ? 'noindex, nofollow' : indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="xBlXg2hsR0TYDNAJKRVv0udFIg0kI72D_2FPEgEG-Vo" />
    <meta name="theme-color" content="#0C1630" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    {indexable && <link rel="canonical" href={url} />}
    <meta property="og:site_name" content="HR Strategy Partners" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content="https://hrstrategypartners.com.ar/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logotipo de HR Strategy Partners: las letras HR dentro de un círculo con degradado de azul a violeta" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://hrstrategypartners.com.ar/og-image.jpg" />
    {schema.map((item) => <script type="application/ld+json" is:inline set:html={JSON.stringify(item)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    {!esBorrador && (
      <>
        {/* Analítica solo en producción: local y vistas previas no cargan visitas falsas. */}
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-49DPPX4M0W"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-49DPPX4M0W');
        </script>
        <script is:inline>
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "z4xtjtnuhv");
        </script>
      </>
    )}
  </head>
  <body class="font-sans text-[#0C1630] bg-[#F8F7FC] overflow-x-hidden">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-5 focus:py-3 focus:rounded-full focus:bg-[#0C1630] focus:text-white focus:text-[14px] focus:font-bold"
      >Saltar al contenido</a
    >
    <slot />
    <script src="../scripts/site.js"></script>
  </body>
</html>
